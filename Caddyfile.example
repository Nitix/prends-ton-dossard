# Replace the domain with the one of APP_URL, and the port with HOST_PORT of
# .env (8090 by default). Caddy gets and renews the HTTPS certificate by itself.
#
# The program trusts the X-Forwarded-For header that Caddy sets: it tells the
# visitors apart for the rate limits. That is safe only because the port of the
# container is bound to 127.0.0.1, so never publish it on a public interface,
# and because Caddy is the first proxy (no trusted_proxies), so it overwrites
# the header that a visitor sends.
courses.example.fr {
	encode zstd gzip

	# The PocketBase dashboard and the sign-in of its superusers stay off the
	# internet: reach them through an SSH tunnel (see the README). The API
	# takes a collection by its id as well as by its name, and pbc_3142635823
	# is the id of _superusers.
	@pbadmin path /_/* /api/collections/_superusers/* /api/collections/pbc_3142635823/*
	respond @pbadmin 404

	# No Cache-Control rule for /assets/* here: the program sets the year-long
	# "immutable" header itself, only on a built file that exists. A rule on
	# the path would also cover the 404 of a missing chunk, which a browser
	# could then keep for a year.

	# /mcp and /api/app/mcp-uploads (the MCP server) go through reverse_proxy
	# like the rest: nothing to add.
	reverse_proxy 127.0.0.1:8090
}
