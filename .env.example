# Public URL of the site: scheme and domain, no path, no IP address.
# Passkeys are tied to this domain: choose it for good before inviting anyone.
APP_URL=https://courses.example.fr

# Port of the machine on which Caddy reaches the site, on 127.0.0.1 only. Change
# it if 8090 is taken, and point reverse_proxy of the Caddyfile at the same port.
HOST_PORT=8090

# Depth of the skins built into the site (web/src/skins/README.md): palette (the
# default, when empty), mix or full. It takes effect at the next build:
# docker compose up -d --build.
# VITE_SKIN_DEPTH=

# Demo instance only: the email of the account that the "Entrer dans la démo"
# button of the login page signs in to, with nothing to type (alice@example.test
# for the accounts of the seed: a member, an admin is refused). It MUST stay
# empty on the real site: anybody could then enter that account. See "Démo" in
# the README.
# DEMO_LOGIN_EMAIL=
