{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The module of the depth of the build is one of src/skins/depth/ (see src/skins/plugin.ts):
    // they all export the same, typed here as the deepest.
    "paths": { "virtual:skin-depth": ["./src/skins/depth/full.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
